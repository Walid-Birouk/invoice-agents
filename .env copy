# Copy to .env and fill in. Real environment variables take precedence over .env.

# Model: any OpenAI-compatible endpoint. Defaults come from config/agents.yaml (DeepSeek).
LLM_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXX
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Other providers, for client deployments:
# Mistral (EU):            LLM_BASE_URL=https://api.mistral.ai/v1   LLM_MODEL=mistral-large-latest
# Self-hosted vLLM (EU):   LLM_BASE_URL=http://your-host:8000/v1    LLM_MODEL=deepseek-ai/DeepSeek-V3
# Offline wiring test:     LLM_BASE_URL=mock

# Optional: use another data folder (erp.json, inbox/, expected.json)
# AP_DATA=./data
